#!/usr/bin/env node
'use strict';

const crypto = require('crypto');
const childProcess = require('child_process');
const fs = require('fs');
const https = require('https');
const net = require('net');
const os = require('os');
const path = require('path');

const CONTROL_SOCKET_PATH = '/tmp/sysmgrd.sock';
const DELIVERY_ACK_TIMEOUT_MS = 10000;
// A VPN connect verdict can take ~35s on the app side; the default ack window
// is far too short for it. VNC enable also waits for its service evaluation,
// so interactive remote-control actions share the longer timeout.
const REMOTE_CONTROL_ACK_TIMEOUT_MS = 60000;
const PING_TIMEOUT_MS = 10000;
// How long a preflight failure waits for the phone to reconnect before giving
// up. Reconnects after a wifi-flap kill are observed to take 9-25s, so 5s
// expired just before the replacement arrived; 30s covers the real-world tail.
const PING_RECONNECT_GRACE_MS = 30000;
// Notifications that fail to deliver are queued and retried when the phone
// reconnects, so a wifi flap delays them instead of dropping them. Per-action
// TTL: an action missing here (vpn/vnc: interactive, the control caller has
// moved on) is never queued.
const REDELIVERY_TTL_MS = {
  message: 10 * 60000,
  reboot: 10 * 60000,
  alarm: 30 * 60000
};
const REDELIVERY_MAX_QUEUE = 50;
const PROXY_V2_SIGNATURE = Buffer.from('\r\n\r\n\0\r\nQUIT\n', 'binary');
const PROXY_HEADER_TIMEOUT_MS = 5000;
const MYSQL_DEFAULT_CLIENT = '/usr/bin/mysql';
const NOTIF_STORE_MAX_FIELD = 4000;
// How many recently-stored notification keys to remember for idempotent retries.
const NOTIF_KEY_MEMORY = 5000;
const BACKUP_HTTP_PATH = '/backup';
// Bounds a malformed or accidental upload without forcing normal app backups
// into memory. The request body is streamed directly to disk.
const BACKUP_MAX_BYTES = 2 * 1024 * 1024 * 1024;

function parseArgs(argv) {
  const args = {};
  for (const item of argv) {
    const match = item.match(/^--([^=]+)=(.*)$/);
    if (match) {
      args[match[1]] = match[2];
    }
  }
  return args;
}

function parseConfigFile(configPath) {
  let contents;
  try {
    contents = fs.readFileSync(configPath, 'utf8').replace(/^\uFEFF/, '');
  } catch (err) {
    console.error(`could not read --config file ${configPath}: ${err.message}`);
    process.exit(2);
  }

  const configArgs = {};
  const lines = contents.split(/\r?\n/);
  for (let index = 0; index < lines.length; index += 1) {
    const line = lines[index].trim();
    if (!line || line.startsWith('#')) {
      continue;
    }
    const match = line.match(/^([A-Za-z0-9][A-Za-z0-9-]*)\s+(.+)$/);
    if (!match) {
      console.error(`invalid config entry at ${configPath}:${index + 1}`);
      process.exit(2);
    }
    configArgs[match[1]] = match[2].trim();
  }
  return configArgs;
}

const commandLineArgs = parseArgs(process.argv.slice(2));
const configArgs = commandLineArgs.config ? parseConfigFile(commandLineArgs.config) : {};
const args = Object.assign({}, configArgs, commandLineArgs);
if (!args.bindip || !args.bindport || !args.log || !args.users) {
  console.error('usage: sysmgrd [--config=<path>] --bindip=<ip> --bindport=<port> --log=<path> --users=<user:pass,user2:pass2> [--backupfile=<path>] [--statefile=<path>] [--statefilevpn=<path>] [--statefilevnc=<path>]');
  process.exit(2);
}

const bindIp = args.bindip;
const bindPort = Number(args.bindport);
if (!Number.isInteger(bindPort) || bindPort < 1 || bindPort > 65535) {
  console.error('invalid --bindport value');
  process.exit(2);
}

fs.mkdirSync(path.dirname(args.log), {recursive: true});
const logStream = fs.createWriteStream(args.log, {flags: 'a'});
const users = parseUsers(args.users);
if (users.size === 0) {
  console.error('invalid --users value');
  process.exit(2);
}
const gpsMysql = parseGpsMysqlConfig(args);
const notificationStore = createNotificationStore(args);
const backupStore = createBackupStore(args);
// Optional state files mirror the link and service statuses for openHAB. Empty
// paths disable their respective outputs.
const remoteLinkStateFile = {path: args.statefile ? String(args.statefile) : '', last: ''};
const vpnStateFile = {path: args.statefilevpn ? String(args.statefilevpn) : '', last: ''};
const vncStateFile = {path: args.statefilevnc ? String(args.statefilevnc) : '', last: ''};
for (const target of [remoteLinkStateFile, vpnStateFile, vncStateFile]) {
  if (target.path) {
    fs.mkdirSync(path.dirname(target.path), {recursive: true});
  }
}
let nextConnectionId = 1;
let certDir = null;
const clients = new Map();
const pendingDeliveries = new Map();
const pendingPings = new Map();

function log(message) {
  logStream.write(`${formatTimestamp(new Date())} | ${message}\n`);
}

function formatTimestamp(date) {
  return `${date.getFullYear()}-${pad(date.getMonth() + 1, 2)}-${pad(date.getDate(), 2)} ` +
    `${pad(date.getHours(), 2)}:${pad(date.getMinutes(), 2)}:${pad(date.getSeconds(), 2)}.` +
    `${pad(date.getMilliseconds(), 3)}`;
}

function pad(value, width) {
  return String(value).padStart(width, '0');
}

// Status files are written synchronously and via temp+rename so a reader never
// catches a half-written value. Every teardown path feeds this; startup repairs
// the one case it cannot cover, a SIGKILL that prevented final writes.
function writeStateFile(target, label, state) {
  if (!target.path || state === target.last) {
    return;
  }
  const tempPath = `${target.path}.tmp`;
  try {
    fs.writeFileSync(tempPath, state);
    fs.renameSync(tempPath, target.path);
    target.last = state;
    log(`${label} state written state=${state} path=${target.path}`);
  } catch (err) {
    try {
      fs.unlinkSync(tempPath);
    } catch (cleanupErr) {
      // Ignore: the temp file may never have been created.
    }
    log(`${label} state write failed path=${target.path} error=${err.message}`);
  }
}

function featureState(clients, enabledField, connectedField) {
  if (clients.length === 0) {
    return 'Disabled';
  }
  if (clients.some((client) => client[enabledField] === true && client[connectedField] === true)) {
    return 'Connected';
  }
  if (clients.some((client) => client[enabledField] === true)) {
    return 'Disconnected';
  }
  return 'Disabled';
}

function syncStateFiles() {
  const connectedClients = activeClients();
  writeStateFile(remoteLinkStateFile, 'remote link', connectedClients.length > 0 ? 'Online' : 'Offline');
  writeStateFile(vpnStateFile, 'vpn', featureState(connectedClients, 'vpnEnabled', 'vpnConnected'));
  writeStateFile(vncStateFile, 'vnc', featureState(connectedClients, 'vncEnabled', 'vncConnected'));
}

function writeDisconnectedStateFiles() {
  writeStateFile(remoteLinkStateFile, 'remote link', 'Offline');
  writeStateFile(vpnStateFile, 'vpn', 'Disabled');
  writeStateFile(vncStateFile, 'vnc', 'Disabled');
}

function websocketAccept(key) {
  return crypto
    .createHash('sha1')
    .update(`${key}258EAFA5-E914-47DA-95CA-C5AB0DC85B11`)
    .digest('base64');
}

function normalizedAddress(address) {
  const text = String(address || '');
  return text.startsWith('::ffff:') ? text.slice(7) : text;
}

function clientAddress(socket) {
  const proxyInfo = socketProxyInfo(socket);
  return normalizedAddress(proxyInfo && proxyInfo.sourceAddress ? proxyInfo.sourceAddress : socket.remoteAddress);
}

function socketProxyInfo(socket) {
  if (!socket) {
    return null;
  }
  if (socket.proxyProtocol) {
    return socket.proxyProtocol;
  }
  if (socket._parent && socket._parent.proxyProtocol) {
    return socket._parent.proxyProtocol;
  }
  if (socket.socket && socket.socket.proxyProtocol) {
    return socket.socket.proxyProtocol;
  }
  return null;
}

function couldBeProxyV2Header(buffer) {
  const length = Math.min(buffer.length, PROXY_V2_SIGNATURE.length);
  for (let i = 0; i < length; i += 1) {
    if (buffer[i] !== PROXY_V2_SIGNATURE[i]) {
      return false;
    }
  }
  return true;
}

function parseProxyV2Header(buffer) {
  if (buffer.length < 16 || !buffer.slice(0, PROXY_V2_SIGNATURE.length).equals(PROXY_V2_SIGNATURE)) {
    return null;
  }

  const versionCommand = buffer[12];
  const version = versionCommand >> 4;
  const command = versionCommand & 0x0f;
  const familyProtocol = buffer[13];
  const payloadLength = buffer.readUInt16BE(14);
  const totalLength = 16 + payloadLength;
  if (version !== 2) {
    throw new Error(`invalid PROXY protocol version ${version}`);
  }
  if (buffer.length < totalLength) {
    return null;
  }

  const info = {
    sourceAddress: '',
    destinationAddress: '',
    sourcePort: 0,
    destinationPort: 0,
    command,
    familyProtocol
  };

  if (command === 0x00) {
    return {info, totalLength};
  }
  if (command !== 0x01) {
    throw new Error(`invalid PROXY protocol command ${command}`);
  }

  const family = familyProtocol & 0xf0;
  const protocol = familyProtocol & 0x0f;
  if (protocol !== 0x01) {
    return {info, totalLength};
  }
  if (family === 0x10 && payloadLength >= 12) {
    info.sourceAddress = Array.from(buffer.slice(16, 20)).join('.');
    info.destinationAddress = Array.from(buffer.slice(20, 24)).join('.');
    info.sourcePort = buffer.readUInt16BE(24);
    info.destinationPort = buffer.readUInt16BE(26);
  } else if (family === 0x20 && payloadLength >= 36) {
    info.sourceAddress = formatIpv6(buffer.slice(16, 32));
    info.destinationAddress = formatIpv6(buffer.slice(32, 48));
    info.sourcePort = buffer.readUInt16BE(48);
    info.destinationPort = buffer.readUInt16BE(50);
  }
  return {info, totalLength};
}

function formatIpv6(bytes) {
  const parts = [];
  for (let i = 0; i < 16; i += 2) {
    parts.push(bytes.readUInt16BE(i).toString(16));
  }
  return parts.join(':');
}

function handOffToHttps(socket, initialBuffer) {
  socket.removeAllListeners('data');
  socket.removeAllListeners('error');
  server.emit('connection', socket);
  if (initialBuffer && initialBuffer.length > 0) {
    socket.unshift(initialBuffer);
  }
  socket.resume();
}

function handleIncomingTcpConnection(socket) {
  let buffer = Buffer.alloc(0);
  socket.pause();

  const timeout = setTimeout(() => {
    log(`tcp proxy header timeout from=${normalizedAddress(socket.remoteAddress)}`);
    socket.destroy();
  }, PROXY_HEADER_TIMEOUT_MS);

  function cleanup() {
    clearTimeout(timeout);
    socket.removeListener('data', onData);
    socket.removeListener('error', onError);
  }

  function onError(err) {
    cleanup();
    log(`tcp connection error from=${normalizedAddress(socket.remoteAddress)} error=${err.message}`);
  }

  function onData(chunk) {
    buffer = Buffer.concat([buffer, chunk]);
    if (!couldBeProxyV2Header(buffer)) {
      cleanup();
      handOffToHttps(socket, buffer);
      return;
    }
    if (buffer.length < 16) {
      return;
    }
    let parsed;
    try {
      parsed = parseProxyV2Header(buffer);
    } catch (err) {
      cleanup();
      log(`proxy protocol rejected from=${normalizedAddress(socket.remoteAddress)} error=${err.message}`);
      socket.destroy();
      return;
    }
    if (!parsed) {
      return;
    }

    socket.proxyProtocol = parsed.info;
    if (parsed.info.sourceAddress) {
      log(`proxy protocol received from=${normalizedAddress(socket.remoteAddress)} source=${normalizedAddress(parsed.info.sourceAddress)} source_port=${parsed.info.sourcePort}`);
    } else {
      log(`proxy protocol received from=${normalizedAddress(socket.remoteAddress)} source=unknown`);
    }
    cleanup();
    handOffToHttps(socket, buffer.slice(parsed.totalLength));
  }

  socket.on('data', onData);
  socket.on('error', onError);
  socket.resume();
}

function parseUsers(value) {
  const result = new Map();
  const parts = String(value || '')
    .split(',')
    .map((part) => part.trim())
    .filter(Boolean);
  if (parts.length === 2 && !parts[0].includes(':') && !parts[1].includes(':')) {
    result.set(parts[0], parts[1]);
    return result;
  }
  for (const part of parts) {
    const colon = part.indexOf(':');
    if (colon <= 0) {
      continue;
    }
    const username = part.slice(0, colon).trim();
    const password = part.slice(colon + 1);
    if (username) {
      result.set(username, password);
    }
  }
  return result;
}

function parseGpsMysqlConfig(parsedArgs) {
  const hasGpsArg = Object.keys(parsedArgs).some((key) => key.startsWith('gps-mysql-') || key.startsWith('gps-home-') || key === 'gps-username');
  if (!hasGpsArg) {
    return {enabled: false};
  }

  const missing = [];
  for (const key of ['gps-mysql-user', 'gps-mysql-password', 'gps-mysql-database', 'gps-mysql-table', 'gps-username', 'gps-home-lat', 'gps-home-lon']) {
    if (!String(parsedArgs[key] || '').trim()) {
      missing.push(`--${key}`);
    }
  }
  if (!String(parsedArgs['gps-mysql-socket'] || '').trim() && !String(parsedArgs['gps-mysql-host'] || '').trim()) {
    missing.push('--gps-mysql-socket or --gps-mysql-host');
  }
  if (missing.length > 0) {
    console.error(`missing GPS MySQL settings: ${missing.join(', ')}`);
    process.exit(2);
  }

  const table = String(parsedArgs['gps-mysql-table']).trim();
  const database = String(parsedArgs['gps-mysql-database']).trim();
  if (!isSafeSqlIdentifier(table) || !isSafeSqlIdentifier(database)) {
    console.error('invalid GPS MySQL database or table identifier');
    process.exit(2);
  }

  const homeLat = Number(parsedArgs['gps-home-lat']);
  const homeLon = Number(parsedArgs['gps-home-lon']);
  const radiusKm = parsedArgs['gps-home-radius-km'] === undefined ? 0.15 : Number(parsedArgs['gps-home-radius-km']);
  const port = parsedArgs['gps-mysql-port'] === undefined ? 3306 : Number(parsedArgs['gps-mysql-port']);
  if (!Number.isFinite(homeLat) || homeLat < -90 || homeLat > 90 ||
      !Number.isFinite(homeLon) || homeLon < -180 || homeLon > 180 ||
      !Number.isFinite(radiusKm) || radiusKm < 0 ||
      !Number.isInteger(port) || port < 1 || port > 65535) {
    console.error('invalid GPS MySQL numeric settings');
    process.exit(2);
  }

  return {
    enabled: true,
    client: String(parsedArgs['gps-mysql-client'] || MYSQL_DEFAULT_CLIENT).trim(),
    socket: String(parsedArgs['gps-mysql-socket'] || '').trim(),
    host: String(parsedArgs['gps-mysql-host'] || 'localhost').trim(),
    port,
    user: String(parsedArgs['gps-mysql-user']).trim(),
    password: String(parsedArgs['gps-mysql-password']),
    database,
    table,
    username: String(parsedArgs['gps-username']).trim(),
    homeLat,
    homeLon,
    radiusKm
  };
}

function isSafeSqlIdentifier(value) {
  return /^[A-Za-z0-9_]+$/.test(String(value || ''));
}

function createNotificationStore(parsedArgs) {
  const target = String(parsedArgs.notificationstore || '').trim();
  if (!target) {
    return {enabled: false, path: '', stream: null, recentKeys: new Set(), recentOrder: []};
  }
  try {
    fs.mkdirSync(path.dirname(target), {recursive: true});
  } catch (err) {
    console.error(`could not create notification store directory: ${err.message}`);
    process.exit(2);
  }
  let stream;
  try {
    stream = fs.createWriteStream(target, {flags: 'a', mode: 0o600});
  } catch (err) {
    console.error(`could not open notification store: ${err.message}`);
    process.exit(2);
  }
  stream.on('error', (err) => log(`notification store write error ${err.message}`));
  return {enabled: true, path: target, stream, recentKeys: new Set(), recentOrder: []};
}

function createBackupStore(parsedArgs) {
  const target = String(parsedArgs.backupfile || '').trim();
  if (!target) {
    return {enabled: false, path: '', upload: null};
  }
  try {
    fs.mkdirSync(path.dirname(target), {recursive: true});
    const existing = fs.existsSync(target) ? fs.statSync(target) : null;
    if (existing && !existing.isFile()) {
      throw new Error('target exists and is not a regular file');
    }
  } catch (err) {
    console.error(`could not prepare backup file: ${err.message}`);
    process.exit(2);
  }
  return {enabled: true, path: target, upload: null};
}

function backupInfo() {
  if (!backupStore.enabled) {
    return {backup: false, backup_exists: false, backup_mtime: 0};
  }
  try {
    const stat = fs.statSync(backupStore.path);
    return {
      backup: stat.isFile(),
      backup_exists: stat.isFile(),
      backup_mtime: stat.isFile() ? Math.round(stat.mtimeMs) : 0
    };
  } catch (err) {
    if (err.code !== 'ENOENT') {
      log(`backup status failed path=${backupStore.path} error=${err.message}`);
    }
    return {backup: true, backup_exists: false, backup_mtime: 0};
  }
}

function sendBackupStatus(socket, type, extra) {
  sendJson(socket, Object.assign({
    type,
    ts: Math.floor(Date.now() / 1000)
  }, backupInfo(), extra || {}));
}

function cleanNotifKey(value) {
  const key = String(value || '').trim().toLowerCase();
  return /^[0-9a-f]{16,128}$/.test(key) ? key : '';
}

function notifString(value) {
  return String(value === undefined || value === null ? '' : value).slice(0, NOTIF_STORE_MAX_FIELD);
}

function notifInteger(value) {
  const number = Number(value);
  return Number.isFinite(number) ? Math.trunc(number) : null;
}

function notificationKeySeen(key) {
  if (notificationStore.recentKeys.has(key)) {
    return true;
  }
  notificationStore.recentKeys.add(key);
  notificationStore.recentOrder.push(key);
  while (notificationStore.recentOrder.length > NOTIF_KEY_MEMORY) {
    notificationStore.recentKeys.delete(notificationStore.recentOrder.shift());
  }
  return false;
}

function storeNotification(connectionId, message) {
  if (!notificationStore.enabled) {
    return {ok: false, reason: 'store-not-configured'};
  }
  const key = cleanNotifKey(message.key);
  if (!key) {
    log(`notif backup rejected connection=${connectionId} reason=invalid-key`);
    return {ok: false, reason: 'invalid-key'};
  }
  // The app's hash key makes retries idempotent: a duplicate (a re-sent record
  // whose ack was lost) is acknowledged ok so the phone clears it, but not
  // written a second time.
  if (notificationKeySeen(key)) {
    log(`notif backup duplicate connection=${connectionId} key=${key}`);
    return {ok: true, reason: 'duplicate'};
  }

  const now = new Date();
  const shownAtMs = notifInteger(message.shown_at);
  const postedAtMs = notifInteger(message.posted_at);
  const record = {
    received_at: formatTimestamp(now),
    received_at_ms: now.getTime(),
    device_uuid: cleanUuid(message.uuid),
    key,
    shown_at: shownAtMs !== null ? formatTimestamp(new Date(shownAtMs)) : '',
    shown_at_ms: shownAtMs,
    posted_at_ms: postedAtMs,
    package: notifString(message.package),
    app_label: notifString(message.app_label),
    category: notifString(message.category),
    channel: notifString(message.channel),
    priority: notifInteger(message.priority),
    is_sysmgr: Boolean(message.is_sysmgr),
    title: notifString(message.title),
    text: notifString(message.text)
  };

  try {
    notificationStore.stream.write(`${JSON.stringify(record)}\n`);
  } catch (err) {
    // Not actually stored; let the app retry instead of dropping it.
    notificationStore.recentKeys.delete(key);
    log(`notif backup write failed connection=${connectionId} key=${key} error=${logValue(err && err.message ? err.message : err)}`);
    return {ok: false, reason: 'write-failed'};
  }
  log(`notif backup stored connection=${connectionId} key=${key} package=${logValue(record.package)} title=${logValue(record.title)}`);
  return {ok: true, reason: 'stored'};
}

function basicCredentials(headerValue) {
  if (!headerValue || !headerValue.toLowerCase().startsWith('basic ')) {
    return null;
  }
  try {
    const decoded = Buffer.from(headerValue.slice(6).trim(), 'base64').toString('utf8');
    const colon = decoded.indexOf(':');
    if (colon < 0) {
      return null;
    }
    return {
      username: decoded.slice(0, colon),
      password: decoded.slice(colon + 1)
    };
  } catch (err) {
    return null;
  }
}

function authorizedCredentials(headerValue) {
  const credentials = basicCredentials(headerValue);
  if (!credentials || !users.has(credentials.username)) {
    return null;
  }
  const expected = Buffer.from(users.get(credentials.username), 'utf8');
  const actual = Buffer.from(credentials.password, 'utf8');
  if (expected.length !== actual.length || !crypto.timingSafeEqual(expected, actual)) {
    return null;
  }
  return credentials;
}

function writeUnauthorizedSocket(socket) {
  socket.end(
    'HTTP/1.1 401 Unauthorized\r\n' +
    'WWW-Authenticate: Basic realm="sysmgrd"\r\n' +
    'Connection: close\r\n' +
    'Content-Length: 13\r\n' +
    '\r\n' +
    'unauthorized\n'
  );
}

function sendFrame(socket, opcode, payload) {
  const data = Buffer.isBuffer(payload) ? payload : Buffer.from(payload || '', 'utf8');
  const header = [];
  header.push(0x80 | opcode);
  if (data.length <= 125) {
    header.push(data.length);
  } else if (data.length <= 65535) {
    header.push(126, (data.length >> 8) & 0xff, data.length & 0xff);
  } else {
    const extended = Buffer.alloc(8);
    extended.writeBigUInt64BE(BigInt(data.length));
    socket.write(Buffer.concat([Buffer.from(header.concat([127])), extended, data]));
    return;
  }
  socket.write(Buffer.concat([Buffer.from(header), data]));
}

function sendJson(socket, value) {
  sendFrame(socket, 0x1, JSON.stringify(value));
}

function parseFrames(state, chunk, onFrame) {
  state.buffer = Buffer.concat([state.buffer, chunk]);
  while (state.buffer.length >= 2) {
    const first = state.buffer[0];
    const second = state.buffer[1];
    const masked = (second & 0x80) !== 0;
    let length = second & 0x7f;
    let offset = 2;

    if (length === 126) {
      if (state.buffer.length < offset + 2) return;
      length = state.buffer.readUInt16BE(offset);
      offset += 2;
    } else if (length === 127) {
      if (state.buffer.length < offset + 8) return;
      const longLength = state.buffer.readBigUInt64BE(offset);
      if (longLength > BigInt(Number.MAX_SAFE_INTEGER)) {
        throw new Error('websocket frame too large');
      }
      length = Number(longLength);
      offset += 8;
    }

    let mask;
    if (masked) {
      if (state.buffer.length < offset + 4) return;
      mask = state.buffer.slice(offset, offset + 4);
      offset += 4;
    }
    if (state.buffer.length < offset + length) return;

    const payload = Buffer.from(state.buffer.slice(offset, offset + length));
    state.buffer = state.buffer.slice(offset + length);
    if (mask) {
      for (let i = 0; i < payload.length; i += 1) {
        payload[i] ^= mask[i % 4];
      }
    }
    onFrame(first & 0x0f, payload);
  }
}

function cleanUuid(value) {
  const uuid = String(value || '').trim().toLowerCase();
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(uuid) ? uuid : '';
}

function assignClientUuid(connectionId, socket, rawUuid) {
  const uuid = cleanUuid(rawUuid);
  const client = clients.get(connectionId);
  if (!client) {
    return '';
  }
  if (!uuid) {
    client.uuid = '';
    socket.clientUuid = '';
    return '';
  }

  client.uuid = uuid;
  socket.clientUuid = uuid;
  for (const other of clients.values()) {
    if (other.id === connectionId || other.uuid !== uuid || !other.socket || other.socket.destroyed) {
      continue;
    }
    other.supersededBy = connectionId;
    other.supersededAt = Date.now();
    log(`uuid duplicate detected uuid=${uuid} new_connection=${connectionId} old_connection=${other.id} old_from=${other.from || ''}; terminating old connection`);
    resolveSupersededPings(uuid, other.id, connectionId);
    try {
      sendFrame(other.socket, 0x8, Buffer.from('duplicate uuid', 'utf8'));
    } catch (err) {
      log(`uuid duplicate close frame failed old_connection=${other.id} error=${err.message}`);
    }
    other.socket.destroy();
  }
  return uuid;
}

function handleTextMessage(connectionId, socket, text) {
  let parsed = null;
  try {
    parsed = JSON.parse(text);
  } catch (err) {
    log(`connection=${connectionId} text ${text}`);
    return;
  }

  if (parsed.type === 'heartbeat') {
    const client = clients.get(connectionId);
    if (client) {
      client.lastHeartbeatAt = Date.now();
      if (Number.isFinite(parsed.battery)) client.battery = parsed.battery;
      if (typeof parsed.vpn_enabled === 'boolean') client.vpnEnabled = parsed.vpn_enabled;
      if (typeof parsed.vpn_connected === 'boolean') client.vpnConnected = parsed.vpn_connected;
      if (typeof parsed.vnc_enabled === 'boolean') client.vncEnabled = parsed.vnc_enabled;
      if (typeof parsed.vnc_connected === 'boolean') client.vncConnected = parsed.vnc_connected;
    }
    log(`heartbeat received connection=${connectionId}` +
      ` ts=${logValue(parsed.ts)} battery=${logValue(parsed.battery)}` +
      ` vpn_enabled=${logValue(parsed.vpn_enabled)}` +
      ` vpn_connected=${logValue(parsed.vpn_connected)}` +
      ` vnc_enabled=${logValue(parsed.vnc_enabled)}` +
      ` vnc_connected=${logValue(parsed.vnc_connected)}`);
    syncStateFiles();
    sendBackupStatus(socket, 'heartbeat_ack', {notif_backup: notificationStore.enabled});
    return;
  }
  if (parsed.type === 'gps') {
    const result = handleGpsMessage(connectionId, parsed);
    sendGpsAck(connectionId, socket, parsed.id, result);
    return;
  }
  if (parsed.type === 'notif_backup') {
    const result = storeNotification(connectionId, parsed);
    sendJson(socket, {
      type: 'notif_backup_ack',
      key: String(parsed.key || '').slice(0, 128),
      ok: result.ok,
      reason: result.reason,
      ts: Math.floor(Date.now() / 1000)
    });
    return;
  }
  if (parsed.type === 'notif_backup_probe') {
    sendJson(socket, {
      type: 'notif_backup_status',
      id: String(parsed.id || ''),
      enabled: notificationStore.enabled,
      ts: Math.floor(Date.now() / 1000)
    });
    return;
  }
  if (parsed.type === 'ack' && parsed.id) {
    handleAck(connectionId, String(parsed.id), parsed.ok, parsed.reason, parsed.state,
      parsed.vnc_enabled, parsed.vnc_connected);
    return;
  }
  if (parsed.type === 'ping') {
    const id = String(parsed.id || '');
    log(`ping received connection=${connectionId} id=${id} source=${parsed.source || ''}`);
    sendJson(socket, {
      type: 'pong',
      id,
      ts: Math.floor(Date.now() / 1000),
      source: 'sysmgrd'
    });
    log(`pong sent connection=${connectionId} id=${id}`);
    return;
  }
  if (parsed.type === 'pong') {
    handlePong(connectionId, parsed.id);
    return;
  }
  if (parsed.type === 'hello') {
    const uuid = assignClientUuid(connectionId, socket, parsed.uuid || parsed.client_uuid || parsed.device_uuid);
    log(`hello received connection=${connectionId} app=${parsed.app || ''} version=${parsed.version || ''} uuid=${uuid || ''} heartbeat_seconds=${parsed.heartbeat_seconds || ''}`);
    sendBackupStatus(socket, 'hello_ack', {notif_backup: notificationStore.enabled});
    flushRedeliveryQueue('hello').catch((err) => log(`redelivery flush error ${err && err.stack ? err.stack : err}`));
    return;
  }
  log(`message received connection=${connectionId} type=${parsed.type || 'unknown'} body=${text}`);
}

function logValue(value) {
  return String(value === undefined || value === null ? '' : value)
    .replace(/[\r\n|]/g, ' ')
    .slice(0, 240);
}

function handleGpsMessage(connectionId, message) {
  log(`gps received connection=${connectionId}` +
    ` lat=${logValue(message.lat)}` +
    ` lon=${logValue(message.lon)}` +
    ` batt=${logValue(message.batt)}` +
    ` bssid=${logValue(message.bssid)}` +
    ` ssid=${logValue(message.ssid)}` +
    ` accuracy=${logValue(message.accuracy)}` +
    ` provider=${logValue(message.provider)}` +
    ` source=${logValue(message.source)}` +
    ` reason=${logValue(message.reason)}` +
    ` ts=${logValue(message.ts)}`);
  return insertGpsMessage(connectionId, message);
}

function sendGpsAck(connectionId, socket, id, result) {
  const ackId = String(id || '');
  const ok = Boolean(result && result.ok);
  const reason = result && result.reason ? result.reason : '';
  try {
    sendJson(socket, {
      type: 'gps_ack',
      id: ackId,
      ok,
      reason,
      ts: Math.floor(Date.now() / 1000)
    });
    log(`gps ack sent connection=${connectionId} id=${logValue(ackId)} ok=${ok} reason=${logValue(reason)}`);
  } catch (err) {
    log(`gps ack failed connection=${connectionId} id=${logValue(ackId)} error=${logValue(err && err.message ? err.message : err)}`);
  }
}

function parseGpsNumber(value, min, max) {
  const text = String(value === undefined || value === null ? '' : value).trim();
  if (!/^-?\d+(\.\d+)?$/.test(text)) {
    return null;
  }
  const number = Number(text);
  if (!Number.isFinite(number) || number < min || number > max) {
    return null;
  }
  return number;
}

function parseBatteryPercent(value) {
  const text = String(value === undefined || value === null ? '' : value).trim();
  if (!/^\d{1,3}$/.test(text)) {
    return null;
  }
  const number = Number(text);
  return Number.isInteger(number) ? number : null;
}

function roundTo(value, places) {
  const factor = 10 ** places;
  return Math.round(value * factor) / factor;
}

function haversineKm(latFrom, lonFrom, latTo, lonTo) {
  const earthRadius = 6371;
  const fromLat = latFrom * Math.PI / 180;
  const fromLon = lonFrom * Math.PI / 180;
  const toLat = latTo * Math.PI / 180;
  const toLon = lonTo * Math.PI / 180;
  const latDelta = toLat - fromLat;
  const lonDelta = toLon - fromLon;
  const angle = 2 * Math.asin(Math.sqrt(
    Math.sin(latDelta / 2) ** 2 +
    Math.cos(fromLat) * Math.cos(toLat) * Math.sin(lonDelta / 2) ** 2
  ));
  return earthRadius * angle;
}

function sqlString(value) {
  return `'${String(value)
    .replace(/\\/g, '\\\\')
    .replace(/\0/g, '\\0')
    .replace(/\n/g, '\\n')
    .replace(/\r/g, '\\r')
    .replace(/\x1a/g, '\\Z')
    .replace(/'/g, "\\'")}'`;
}

function insertGpsMessage(connectionId, message) {
  if (!gpsMysql.enabled) {
    log(`gps mysql insert skipped connection=${connectionId} reason=not-configured`);
    return {ok: false, reason: 'mysql-not-configured'};
  }

  const lat = parseGpsNumber(message.lat, -90, 90);
  const lon = parseGpsNumber(message.lon, -180, 180);
  const batt = parseBatteryPercent(message.batt);
  if (lat === null || lon === null || batt === null) {
    log(`gps mysql insert failed connection=${connectionId} reason=invalid-values lat=${logValue(message.lat)} lon=${logValue(message.lon)} batt=${logValue(message.batt)}`);
    return {ok: false, reason: 'invalid-values'};
  }

  const distance = roundTo(haversineKm(gpsMysql.homeLat, gpsMysql.homeLon, lat, lon), 2);
  const awayFromHome = distance > gpsMysql.radiusKm;
  const insertLat = awayFromHome ? roundTo(lat, 7) : roundTo(gpsMysql.homeLat, 7);
  const insertLon = awayFromHome ? roundTo(lon, 7) : roundTo(gpsMysql.homeLon, 7);
  const insertDistance = awayFromHome ? distance : 0;
  const sql = `INSERT INTO \`${gpsMysql.table}\` (username,timestamp,lat,lon,batt,distancehome) ` +
    `VALUES (${sqlString(gpsMysql.username)},NOW(),${insertLat.toFixed(7)},${insertLon.toFixed(7)},${batt},${insertDistance.toFixed(2)})`;
  const mysqlArgs = [
    '--batch',
    '--silent',
    '--protocol=socket',
    `--user=${gpsMysql.user}`,
    `--database=${gpsMysql.database}`,
    '--execute',
    sql
  ];
  if (gpsMysql.socket) {
    mysqlArgs.splice(3, 0, `--socket=${gpsMysql.socket}`);
  } else {
    mysqlArgs[2] = '--protocol=tcp';
    mysqlArgs.splice(3, 0, `--host=${gpsMysql.host}`, `--port=${gpsMysql.port}`);
  }

  try {
    childProcess.execFileSync(gpsMysql.client, mysqlArgs, {
      env: Object.assign({}, process.env, {MYSQL_PWD: gpsMysql.password}),
      stdio: ['ignore', 'pipe', 'pipe'],
      timeout: 10000
    });
    log(`gps mysql insert succeeded connection=${connectionId} lat=${insertLat.toFixed(7)} lon=${insertLon.toFixed(7)} batt=${batt} distancehome=${insertDistance.toFixed(2)} source=${awayFromHome ? 'reported' : 'home'}`);
    return {ok: true, reason: 'inserted'};
  } catch (err) {
    const stderr = err && err.stderr ? String(err.stderr).replace(/\s+/g, ' ').trim() : '';
    log(`gps mysql insert failed connection=${connectionId} error=${logValue(err && err.message ? err.message : err)} stderr=${logValue(stderr)}`);
    return {ok: false, reason: 'mysql-failed'};
  }
}

function handleAck(connectionId, messageId, okValue, reasonValue, stateValue,
                   vncEnabledValue, vncConnectedValue) {
  const pending = pendingDeliveries.get(messageId);
  if (!pending) {
    log(`ack ignored connection=${connectionId} id=${messageId}`);
    return;
  }
  clearTimeout(pending.timer);
  pendingDeliveries.delete(messageId);
  const ok = okValue !== false;
  const reason = reasonValue ? String(reasonValue) : '';
  const state = stateValue ? String(stateValue) : '';
  const vncEnabled = typeof vncEnabledValue === 'boolean' ? vncEnabledValue : null;
  const vncConnected = typeof vncConnectedValue === 'boolean' ? vncConnectedValue : null;
  const client = clients.get(connectionId);
  if (client) {
    if (vncEnabled !== null) client.vncEnabled = vncEnabled;
    if (vncConnected !== null) client.vncConnected = vncConnected;
  }
  syncStateFiles();
  log(`message ${ok ? 'acked' : 'rejected'} id=${messageId} connection=${connectionId}`
    + `${state ? ` state=${logValue(state)}` : ''}`
    + `${vncEnabled !== null ? ` vnc_enabled=${vncEnabled}` : ''}`
    + `${vncConnected !== null ? ` vnc_connected=${vncConnected}` : ''}`
    + `${reason ? ` reason=${logValue(reason)}` : ''}`);
  pending.resolve(ok, reason, state, vncEnabled, vncConnected);
}

function handlePong(connectionId, pingId) {
  const id = String(pingId || '');
  const client = clients.get(connectionId);
  log(`pong received connection=${connectionId} uuid=${client && client.uuid ? client.uuid : ''} id=${id}`);
  const pending = pendingPings.get(id);
  if (!pending) {
    return;
  }
  clearTimeout(pending.timer);
  pendingPings.delete(id);
  pending.resolve({
    ok: true,
    id,
    client,
    reason: 'pong',
    connectionId
  });
}

function activeClients() {
  return Array.from(clients.values()).filter((client) => client.socket && !client.socket.destroyed);
}

function replacementClientsFor(sentClients) {
  const sentIds = new Set(sentClients.map((client) => client.id));
  const uuids = new Set(sentClients.map((client) => client.uuid).filter(Boolean));
  if (uuids.size === 0) {
    return [];
  }
  return activeClients().filter((client) => client.uuid && uuids.has(client.uuid) && !sentIds.has(client.id));
}

function uuidsForClients(sentClients) {
  return Array.from(new Set((sentClients || []).map((client) => client.uuid).filter(Boolean)));
}

function waitForReplacementClients(sentClients, timeoutMs) {
  return new Promise((resolve) => {
    let finished = false;
    let interval = null;
    let timeout = null;
    const done = (clients) => {
      if (finished) {
        return;
      }
      finished = true;
      clearInterval(interval);
      clearTimeout(timeout);
      resolve(clients);
    };
    const check = () => {
      const replacements = replacementClientsFor(sentClients);
      if (replacements.length > 0) {
        done(replacements);
      }
    };
    interval = setInterval(check, 250);
    timeout = setTimeout(() => done(replacementClientsFor(sentClients)), timeoutMs);
    check();
  });
}

function resolveConnectionLostPings(connectionId, uuid, reason, excludingId) {
  for (const [id, pending] of pendingPings.entries()) {
    if (id === excludingId) {
      continue;
    }
    if (!pending.sentClients || !pending.sentClients.some((client) => client.id === connectionId)) {
      continue;
    }
    const liveSentClients = pending.sentClients.filter((client) =>
      client.id !== connectionId && !client.supersededBy && client.socket && !client.socket.destroyed);
    if (liveSentClients.length > 0) {
      log(`ping connection lost id=${id} connection=${connectionId} uuid=${uuid || ''} reason=${reason} waiting_clients=${liveSentClients.map((client) => client.id).join(',')}`);
      continue;
    }
    clearTimeout(pending.timer);
    pendingPings.delete(id);
    log(`ping connection lost id=${id} connection=${connectionId} uuid=${uuid || ''} reason=${reason}`);
    pending.resolve({
      id,
      ok: false,
      reason,
      sentClients: pending.sentClients
    });
  }
}

function resolveSupersededPings(uuid, oldConnectionId, newConnectionId) {
  for (const [id, pending] of pendingPings.entries()) {
    if (!pending.sentClients || !pending.sentClients.some((client) => client.id === oldConnectionId && client.uuid === uuid)) {
      continue;
    }
    clearTimeout(pending.timer);
    pendingPings.delete(id);
    log(`ping superseded id=${id} uuid=${uuid} old_connection=${oldConnectionId} new_connection=${newConnectionId}`);
    pending.resolve({
      id,
      ok: false,
      reason: 'superseded',
      sentClients: pending.sentClients
    });
  }
}

function sendApplicationPing(client, id, reason) {
  sendJson(client.socket, {
    type: 'ping',
    id,
    ts: Math.floor(Date.now() / 1000),
    source: 'sysmgrd',
    reason
  });
  log(`ping sent connection=${client.id} uuid=${client.uuid || ''} id=${id} reason=${reason}`);
}

async function pingAnyClient(reason) {
  const first = await pingClientSet(reason, activeClients(), 1);
  if (first.ok) {
    return first;
  }

  let replacements = replacementClientsFor(first.sentClients || []);
  if (replacements.length === 0) {
    const uuids = uuidsForClients(first.sentClients || []);
    if (uuids.length > 0) {
      log(`ping waiting for replacement reason=${reason} prior_id=${first.id} uuids=${uuids.join(',')} timeout_ms=${PING_RECONNECT_GRACE_MS}`);
      replacements = await waitForReplacementClients(first.sentClients || [], PING_RECONNECT_GRACE_MS);
      if (replacements.length > 0) {
        log(`ping replacement appeared reason=${reason} prior_id=${first.id} replacement_connections=${replacements.map((client) => client.id).join(',')}`);
      } else {
        log(`ping replacement wait expired reason=${reason} prior_id=${first.id} uuids=${uuids.join(',')}`);
      }
    }
  }
  if (replacements.length === 0) {
    return first;
  }

  log(`ping retrying reason=${reason} prior_id=${first.id} replacement_connections=${replacements.map((client) => client.id).join(',')} replacement_uuids=${Array.from(new Set(replacements.map((client) => client.uuid).filter(Boolean))).join(',')}`);
  const second = await pingClientSet(`${reason}:replacement`, replacements, 2);
  if (second.ok) {
    return second;
  }
  return {
    id: second.id,
    ok: false,
    reason: `replacement retry failed: ${second.reason}`,
    sentClients: second.sentClients
  };
}

function pingClientSet(reason, candidates, attempt) {
  const id = `ping-${Date.now()}-${crypto.randomBytes(4).toString('hex')}`;
  if (candidates.length === 0) {
    log(`ping failed id=${id} reason=${reason} attempt=${attempt} error=no-connected-clients`);
    return Promise.resolve({id, ok: false, reason: 'no connected clients', sentClients: []});
  }

  return new Promise((resolve) => {
    const sentClients = [];
    const timer = setTimeout(() => {
      pendingPings.delete(id);
      log(`ping failed id=${id} reason=${reason} attempt=${attempt} error=no-pong timeout_ms=${PING_TIMEOUT_MS} clients=${sentClients.map((client) => client.id).join(',')}`);
      for (const client of sentClients) {
        if (client.supersededBy) {
          log(`ping timeout skipped superseded connection=${client.id} uuid=${client.uuid || ''} superseded_by=${client.supersededBy}`);
          continue;
        }
        if (client.socket && !client.socket.destroyed) {
          log(`ping timeout; terminating connection=${client.id} uuid=${client.uuid || ''} from=${client.from || ''}`);
          client.socket.destroy();
        }
        resolveConnectionLostPings(client.id, client.uuid, 'connection-timeout', id);
      }
      resolve({id, ok: false, reason: 'no pong', sentClients});
    }, PING_TIMEOUT_MS);

    pendingPings.set(id, {
      timer,
      resolve,
      sentClients
    });

    for (const client of candidates) {
      try {
        sendApplicationPing(client, id, reason);
        sentClients.push(client);
      } catch (err) {
        log(`ping send failed connection=${client.id} uuid=${client.uuid || ''} id=${id} error=${err.message}`);
        try {
          client.socket.destroy();
        } catch (destroyErr) {
          log(`ping failed connection destroy failed connection=${client.id} error=${destroyErr.message}`);
        }
      }
    }

    if (sentClients.length === 0) {
      clearTimeout(timer);
      pendingPings.delete(id);
      log(`ping failed id=${id} reason=${reason} attempt=${attempt} error=no-sendable-clients`);
      resolve({id, ok: false, reason: 'no sendable clients', sentClients: candidates});
    }
  });
}

async function deliverNotification(notification) {
  const action = notification.action || 'message';
  const preflight = await pingAnyClient(`preflight:${action}`);
  if (!preflight.ok) {
    log(`message delivery failed action=${action} reason=preflight-ping-failed ping_id=${preflight.id} detail=${preflight.reason}`);
    return {id: preflight.id, ok: false, reason: `preflight ping failed: ${preflight.reason}`};
  }

  const availableClients = activeClients();
  const id = `msg-${Date.now()}-${crypto.randomBytes(4).toString('hex')}`;
  const payload = {
    type: 'notification',
    id,
    action,
    message: notification.message || '',
    ts: Math.floor(Date.now() / 1000)
  };
  if (notification.title) {
    payload.title = notification.title;
  }
  if (notification.imageBase64) {
    payload.image_mime = notification.imageMime || 'image/jpeg';
    payload.image_base64 = notification.imageBase64;
  }
  if (action === 'alarm') {
    payload.tone = notification.tone || '';
    payload.length = notification.lengthSeconds || 10;
    payload.vibrate = notification.vibrate !== false;
  }
  if (action === 'vpn') {
    payload.vpn = notification.vpnCommand || 'status';
  }
  if (action === 'vnc') {
    payload.vnc = notification.vncCommand || 'status';
  }
  if (availableClients.length === 0) {
    log(`message delivery failed id=${id} action=${action} reason=no-connected-clients`);
    return Promise.resolve({id, ok: false, reason: 'no connected clients'});
  }

  let sentCount = 0;
  for (const client of availableClients) {
    try {
      sendJson(client.socket, payload);
      sentCount += 1;
    } catch (err) {
      log(`message send failed id=${id} action=${action} connection=${client.id} error=${err.message}`);
    }
  }

  if (sentCount === 0) {
    log(`message delivery failed id=${id} action=${action} reason=no-sendable-clients`);
    return Promise.resolve({id, ok: false, reason: 'no sendable clients'});
  }

  log(`message sent id=${id} action=${action} clients=${sentCount}`);
  const ackTimeoutMs = action === 'vpn' || action === 'vnc'
    ? REMOTE_CONTROL_ACK_TIMEOUT_MS : DELIVERY_ACK_TIMEOUT_MS;
  return new Promise((resolve) => {
    const timer = setTimeout(() => {
      pendingDeliveries.delete(id);
      log(`message delivery failed id=${id} action=${action} reason=no-ack timeout_ms=${ackTimeoutMs}`);
      resolve({id, ok: false, reason: 'no ack', state: ''});
    }, ackTimeoutMs);
    pendingDeliveries.set(id, {
      timer,
      resolve: (ok, reason, state, vncEnabled, vncConnected) => resolve({
        id,
        ok,
        state: state || '',
        vncEnabled,
        vncConnected,
        reason: reason || (ok ? 'acked' : 'failed')
      })
    });
  });
}

const redeliveryQueue = [];
let redeliveryFlushRunning = false;

function queueForRedelivery(notification, failedId, failedReason) {
  const ttlMs = REDELIVERY_TTL_MS[notification.action || 'message'];
  if (!ttlMs) {
    return false;
  }
  if (redeliveryQueue.length >= REDELIVERY_MAX_QUEUE) {
    const dropped = redeliveryQueue.shift();
    log(`redelivery queue full; dropping oldest action=${dropped.notification.action} message=${logValue(dropped.notification.message)}`);
  }
  redeliveryQueue.push({
    notification,
    queuedAt: Date.now(),
    expiresAt: Date.now() + ttlMs
  });
  log(`notification queued for redelivery action=${notification.action} failed_id=${failedId} failed_reason=${logValue(failedReason)} ttl_s=${ttlMs / 1000} queue=${redeliveryQueue.length}`);
  return true;
}

// One flush runs at a time; each entry goes back through deliverNotification,
// whose preflight ping is what proves the reconnected link is actually alive.
// A failed attempt leaves the entry at the head for the next trigger rather
// than looping (each retry already costs a full ping timeout).
async function flushRedeliveryQueue(trigger) {
  if (redeliveryFlushRunning || redeliveryQueue.length === 0) {
    return;
  }
  redeliveryFlushRunning = true;
  try {
    log(`redelivery flush started trigger=${trigger} queue=${redeliveryQueue.length}`);
    while (redeliveryQueue.length > 0) {
      const entry = redeliveryQueue[0];
      if (Date.now() >= entry.expiresAt) {
        redeliveryQueue.shift();
        log(`redelivery expired action=${entry.notification.action} queued_for_s=${Math.round((Date.now() - entry.queuedAt) / 1000)} message=${logValue(entry.notification.message)}`);
        continue;
      }
      if (activeClients().length === 0) {
        log(`redelivery flush paused; no connected clients queue=${redeliveryQueue.length}`);
        return;
      }
      const result = await deliverNotification(entry.notification);
      if (!result.ok) {
        log(`redelivery attempt failed id=${result.id} action=${entry.notification.action} reason=${logValue(result.reason)} queue=${redeliveryQueue.length}`);
        return;
      }
      redeliveryQueue.shift();
      log(`redelivery succeeded id=${result.id} action=${entry.notification.action} delayed_s=${Math.round((Date.now() - entry.queuedAt) / 1000)} queue=${redeliveryQueue.length}`);
    }
  } finally {
    redeliveryFlushRunning = false;
  }
}

function generateSelfSignedCertificate() {
  certDir = fs.mkdtempSync(path.join(os.tmpdir(), 'sysmgrd-cert-'));
  const keyPath = path.join(certDir, 'sysmgrd.key');
  const certPath = path.join(certDir, 'sysmgrd.crt');
  childProcess.execFileSync('openssl', [
    'req',
    '-x509',
    '-newkey',
    'rsa:2048',
    '-sha256',
    '-nodes',
    '-subj',
    '/CN=sysmgrd.local',
    '-days',
    '1',
    '-keyout',
    keyPath,
    '-out',
    certPath
  ], {stdio: 'ignore'});
  return {
    key: fs.readFileSync(keyPath),
    cert: fs.readFileSync(certPath),
    certPath
  };
}

const tlsOptions = generateSelfSignedCertificate();

function backupRequestPath(req) {
  try {
    return new URL(req.url, 'https://sysmgrd.local').pathname;
  } catch (err) {
    return '';
  }
}

function sendBackupHttpError(res, status, message) {
  if (res.headersSent) {
    res.destroy();
    return;
  }
  const body = `${message}\n`;
  res.writeHead(status, {
    'content-type': 'text/plain; charset=utf-8',
    'content-length': Buffer.byteLength(body),
    'cache-control': 'no-store'
  });
  res.end(body);
}

function handleBackupUpload(req, res) {
  if (!backupStore.enabled) {
    sendBackupHttpError(res, 503, 'backup file is not configured');
    return;
  }
  if (backupStore.upload) {
    sendBackupHttpError(res, 409, 'another backup is already in progress');
    return;
  }

  const declaredLength = Number(req.headers['content-length']);
  if (Number.isFinite(declaredLength) &&
      (declaredLength < 1 || declaredLength > BACKUP_MAX_BYTES)) {
    sendBackupHttpError(res, 413, 'backup archive size is invalid');
    return;
  }

  const tempPath = `${backupStore.path}.upload-${process.pid}-${Date.now()}`;
  let output;
  try {
    output = fs.createWriteStream(tempPath, {flags: 'wx', mode: 0o600});
  } catch (err) {
    sendBackupHttpError(res, 500, 'could not create backup archive');
    log(`backup upload create failed path=${backupStore.path} error=${err.message}`);
    return;
  }

  const upload = {tempPath, output, bytes: 0, complete: false};
  backupStore.upload = upload;
  const hash = crypto.createHash('sha256');
  let failed = false;

  function cleanupTemp() {
    try {
      fs.unlinkSync(tempPath);
    } catch (err) {
      if (err.code !== 'ENOENT') {
        log(`backup upload cleanup failed path=${tempPath} error=${err.message}`);
      }
    }
  }

  function fail(status, publicMessage, err) {
    if (failed || upload.complete) {
      return;
    }
    failed = true;
    if (backupStore.upload === upload) {
      backupStore.upload = null;
    }
    try {
      output.destroy();
    } catch (ignored) {
      // Best-effort cleanup below handles the temporary file.
    }
    cleanupTemp();
    sendBackupHttpError(res, status, publicMessage);
    log(`backup upload failed path=${backupStore.path} bytes=${upload.bytes} error=${err && err.message ? err.message : publicMessage}`);
  }

  req.on('data', (chunk) => {
    upload.bytes += chunk.length;
    if (upload.bytes > BACKUP_MAX_BYTES) {
      fail(413, 'backup archive is too large', new Error('size limit exceeded'));
      req.destroy();
      return;
    }
    hash.update(chunk);
  });
  req.on('aborted', () => fail(400, 'backup upload was interrupted', new Error('request aborted')));
  req.on('error', (err) => fail(400, 'backup upload failed', err));
  output.on('error', (err) => fail(500, 'could not write backup archive', err));
  output.on('finish', () => {
    if (failed) {
      return;
    }
    if (upload.bytes < 1 ||
        (Number.isFinite(declaredLength) && upload.bytes !== declaredLength)) {
      fail(400, 'backup upload was incomplete', new Error('content length mismatch'));
      return;
    }
    const digest = hash.digest('hex');
    const expectedDigest = String(req.headers['x-backup-sha256'] || '').trim().toLowerCase();
    if (expectedDigest && (!/^[0-9a-f]{64}$/.test(expectedDigest) || expectedDigest !== digest)) {
      fail(400, 'backup archive checksum mismatch', new Error('checksum mismatch'));
      return;
    }
    try {
      const fd = fs.openSync(tempPath, 'r');
      try {
        fs.fsyncSync(fd);
      } finally {
        fs.closeSync(fd);
      }
      fs.chmodSync(tempPath, 0o600);
      fs.renameSync(tempPath, backupStore.path);
      upload.complete = true;
      if (backupStore.upload === upload) {
        backupStore.upload = null;
      }
      const body = `${JSON.stringify({ok: true, bytes: upload.bytes, sha256: digest})}\n`;
      res.writeHead(200, {
        'content-type': 'application/json; charset=utf-8',
        'content-length': Buffer.byteLength(body),
        'cache-control': 'no-store'
      });
      res.end(body);
      log(`backup stored path=${backupStore.path} bytes=${upload.bytes} sha256=${digest}`);
    } catch (err) {
      fail(500, 'could not store backup archive', err);
    }
  });
  req.pipe(output);
}

function handleBackupDownload(req, res) {
  if (!backupStore.enabled) {
    sendBackupHttpError(res, 503, 'backup file is not configured');
    return;
  }
  let stat;
  try {
    stat = fs.statSync(backupStore.path);
    if (!stat.isFile()) {
      throw new Error('backup target is not a regular file');
    }
  } catch (err) {
    if (err.code === 'ENOENT') {
      sendBackupHttpError(res, 404, 'no backup is available');
    } else {
      sendBackupHttpError(res, 500, 'could not read backup archive');
      log(`backup download stat failed path=${backupStore.path} error=${err.message}`);
    }
    return;
  }

  res.writeHead(200, {
    'content-type': 'application/gzip',
    'content-length': stat.size,
    'content-disposition': 'attachment; filename="sysmgr.backup.tar.gz"',
    'last-modified': stat.mtime.toUTCString(),
    'cache-control': 'no-store'
  });
  if (req.method === 'HEAD') {
    res.end();
    return;
  }
  const input = fs.createReadStream(backupStore.path);
  input.on('error', (err) => {
    log(`backup download failed path=${backupStore.path} error=${err.message}`);
    res.destroy();
  });
  res.on('finish', () => log(`backup sent path=${backupStore.path} bytes=${stat.size}`));
  input.pipe(res);
}

function handleBackupRequest(req, res) {
  if (req.method === 'PUT') {
    handleBackupUpload(req, res);
    return;
  }
  if (req.method === 'GET' || req.method === 'HEAD') {
    handleBackupDownload(req, res);
    return;
  }
  res.writeHead(405, {'allow': 'GET, HEAD, PUT', 'content-length': '0'});
  res.end();
}

const server = https.createServer(tlsOptions, (req, res) => {
  const credentials = authorizedCredentials(req.headers.authorization);
  if (!credentials) {
    log(`http unauthorized ${req.method} ${req.url} from=${clientAddress(req.socket)}`);
    res.writeHead(401, {
      'content-type': 'text/plain',
      'www-authenticate': 'Basic realm="sysmgrd"',
      'connection': 'close'
    });
    res.end('unauthorized\n');
    return;
  }
  if (backupRequestPath(req) === BACKUP_HTTP_PATH) {
    log(`http backup ${req.method} from=${clientAddress(req.socket)} user=${credentials.username}`);
    handleBackupRequest(req, res);
    return;
  }
  log(`http ${req.method} ${req.url} from=${clientAddress(req.socket)}`);
  res.writeHead(200, {'content-type': 'text/plain'});
  res.end('sysmgrd\n');
});

server.on('secureConnection', (socket) => {
  const proxyInfo = socketProxyInfo(socket);
  if (proxyInfo) {
    socket.proxyProtocol = proxyInfo;
  }
});

server.on('upgrade', (req, socket) => {
  const credentials = authorizedCredentials(req.headers.authorization);
  if (!credentials) {
    log(`websocket unauthorized from=${clientAddress(req.socket)}`);
    writeUnauthorizedSocket(socket);
    return;
  }
  const key = req.headers['sec-websocket-key'];
  if (!key) {
    socket.end('HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n');
    return;
  }

  const connectionId = nextConnectionId++;
  const client = {
    id: connectionId,
    socket,
    user: credentials.username,
    uuid: '',
    from: clientAddress(req.socket),
    lastHeartbeatAt: 0,
    battery: null,
    vpnEnabled: null,
    vpnConnected: null,
    vncEnabled: null,
    vncConnected: null
  };
  clients.set(connectionId, client);
  socket.write(
    'HTTP/1.1 101 Switching Protocols\r\n' +
    'Upgrade: websocket\r\n' +
    'Connection: Upgrade\r\n' +
    `Sec-WebSocket-Accept: ${websocketAccept(key)}\r\n` +
    '\r\n'
  );
  log(`websocket connected connection=${connectionId} from=${client.from} user=${credentials.username}`);
  syncStateFiles();
  sendJson(socket, {type: 'connected', connection_id: connectionId, ts: Math.floor(Date.now() / 1000)});

  const state = {buffer: Buffer.alloc(0)};
  socket.on('data', (chunk) => {
    try {
      parseFrames(state, chunk, (opcode, payload) => {
        if (opcode === 0x1) {
          handleTextMessage(connectionId, socket, payload.toString('utf8'));
        } else if (opcode === 0x8) {
          log(`websocket close frame connection=${connectionId}`);
          socket.end();
        } else if (opcode === 0x9) {
          sendFrame(socket, 0xA, payload);
        }
      });
    } catch (err) {
      log(`websocket parse error connection=${connectionId} error=${err.message}`);
      socket.destroy();
    }
  });
  socket.on('end', () => {
    log(`websocket ended connection=${connectionId}`);
    socket.destroy();
  });
  socket.on('close', () => {
    log(`websocket disconnected connection=${connectionId}`);
    const closedClient = clients.get(connectionId);
    if (closedClient) {
      resolveConnectionLostPings(connectionId, closedClient.uuid, 'connection-closed');
    }
    clients.delete(connectionId);
    // Fires for a clean close frame and for an abruptly dropped socket alike.
    syncStateFiles();
  });
  socket.on('error', (err) => log(`websocket error connection=${connectionId} error=${err.message}`));
});

server.on('error', (err) => {
  log(`daemon error ${err.message}`);
  process.exitCode = 1;
});

const tcpServer = net.createServer(handleIncomingTcpConnection);
tcpServer.on('error', (err) => {
  log(`tcp server error ${err.message}`);
  process.exitCode = 1;
});
tcpServer.listen(bindPort, bindIp, () => {
  log(`daemon startup bindip=${bindIp} bindport=${bindPort} pid=${process.pid} tls=self-signed proxy_protocol=v2_optional cert=${tlsOptions.certPath} users=${Array.from(users.keys()).join(',')} gps_mysql=${gpsMysql.enabled ? `enabled table=${gpsMysql.table}` : 'disabled'} notif_store=${notificationStore.enabled ? `enabled path=${notificationStore.path}` : 'disabled'} backup_file=${backupStore.enabled ? `enabled path=${backupStore.path}` : 'disabled'} statefile=${remoteLinkStateFile.path || 'disabled'} statefilevpn=${vpnStateFile.path || 'disabled'} statefilevnc=${vncStateFile.path || 'disabled'}`);
  // No clients yet, so this also clears stale values left by a hard kill.
  syncStateFiles();
});

function parseControlMessage(text) {
  const result = {};
  for (const rawLine of String(text || '').split(/\r?\n/)) {
    const line = rawLine.trim();
    if (!line || line.startsWith('#')) {
      continue;
    }
    const match = line.match(/^([^=]+?)\s*=\s*(.*)$/);
    if (!match) {
      continue;
    }
    result[match[1].trim().toLowerCase()] = match[2];
  }
  return result;
}

function parseControlBoolean(value, fallback) {
  const text = String(value === undefined || value === null ? '' : value).trim().toLowerCase();
  if (!text) {
    return fallback;
  }
  if (['1', 'true', 'yes', 'on'].includes(text)) {
    return true;
  }
  if (['0', 'false', 'no', 'off'].includes(text)) {
    return false;
  }
  return fallback;
}

function parseControlSeconds(value, fallback, min, max) {
  const number = Number(String(value === undefined || value === null ? '' : value).trim());
  if (!Number.isFinite(number)) {
    return fallback;
  }
  return Math.max(min, Math.min(max, Math.round(number)));
}

function startControlSocket() {
  try {
    fs.unlinkSync(CONTROL_SOCKET_PATH);
  } catch (err) {
    if (err.code !== 'ENOENT') {
      throw err;
    }
  }

  const controlServer = net.createServer({allowHalfOpen: true}, (socket) => {
    let buffer = '';
    socket.setEncoding('utf8');
    socket.on('data', (chunk) => {
      buffer += chunk;
    });
    socket.on('end', async () => {
      const request = parseControlMessage(buffer);
      request.action = String(request.action || '').trim().toLowerCase();
      if (!['message', 'reboot', 'ping', 'alarm', 'vpn', 'vnc'].includes(request.action) || (request.action === 'message' && !request.message)) {
        log(`control request rejected reason=invalid body=${JSON.stringify(request)}`);
        socket.end('error invalid request\n');
        return;
      }
      if (request.action === 'vpn') {
        request.cmd = String(request.cmd || '').trim().toLowerCase();
        if (!['connect', 'disconnect', 'status'].includes(request.cmd)) {
          log(`control vpn rejected reason=invalid-cmd cmd=${logValue(request.cmd)}`);
          socket.end('error invalid request\n');
          return;
        }
        request.message = request.message || `Remote VPN ${request.cmd} requested`;
      }
      if (request.action === 'vnc') {
        request.cmd = String(request.cmd || '').trim().toLowerCase();
        if (!['enable', 'disable', 'status'].includes(request.cmd)) {
          log(`control vnc rejected reason=invalid-cmd cmd=${logValue(request.cmd)}`);
          socket.end('error invalid request\n');
          return;
        }
        request.message = request.message || `Remote VNC ${request.cmd} requested`;
      }
      if (request.action === 'ping') {
        log('control ping requested');
        const result = await pingAnyClient('control');
        socket.end(result.ok
          ? `ok id=${result.id} connection=${result.connectionId}\n`
          : `error id=${result.id} reason=${result.reason}\n`);
        return;
      }
      if (request.action === 'reboot' && !request.message) {
        request.message = 'Remote reboot requested';
      }
      if (request.action === 'alarm') {
        request.message = request.message || 'Remote alarm requested';
        request.tone = String(request.tone || '').trim();
        request.length = parseControlSeconds(request.length, 10, 1, 300);
        request.vibrate = parseControlBoolean(request.vibrate, true);
      }
      const imageBase64 = request.image_base64 || '';
      const imageBytes = imageBase64 ? Buffer.byteLength(imageBase64, 'base64') : 0;
      if (request.action === 'alarm') {
        log(`control alarm requested tone=${logValue(request.tone)} length=${request.length} vibrate=${request.vibrate}`);
      } else if (request.action === 'vpn' || request.action === 'vnc') {
        log(`control ${request.action} requested cmd=${logValue(request.cmd)}`);
      } else {
        log(`control notification requested action=${request.action} title=${request.title || ''} image_bytes=${imageBytes} message=${request.message}`);
      }
      const notification = {
        action: request.action,
        title: request.title || '',
        message: request.message,
        imageMime: request.image_mime || '',
        imageBase64,
        tone: request.tone || '',
        lengthSeconds: request.length,
        vibrate: request.vibrate,
        vpnCommand: request.action === 'vpn' ? request.cmd : '',
        vncCommand: request.action === 'vnc' ? request.cmd : ''
      };
      const result = await deliverNotification(notification);
      if (!result.ok && queueForRedelivery(notification, result.id, result.reason)) {
        // The phone may have reconnected while this delivery was failing, in
        // which case the hello-triggered flush already ran on an empty queue.
        flushRedeliveryQueue('post-failure').catch((err) => log(`redelivery flush error ${err && err.stack ? err.stack : err}`));
      }
      if (request.action === 'vpn') {
        socket.end(result.ok
          ? `ok id=${result.id} state=${result.state || 'unknown'}\n`
          : `error id=${result.id} reason=${result.reason}\n`);
      } else if (request.action === 'vnc') {
        const validVncAck = typeof result.vncEnabled === 'boolean'
          && typeof result.vncConnected === 'boolean';
        if (result.ok && validVncAck) {
          socket.end(`ok id=${result.id} state=${result.state || 'unknown'}`
            + ` enabled=${result.vncEnabled} connected=${result.vncConnected}\n`);
        } else {
          const reason = result.ok ? 'client does not support vnc control' : result.reason;
          socket.end(`error id=${result.id} reason=${reason}\n`);
        }
      } else {
        socket.end(result.ok ? `ok id=${result.id}\n` : `error id=${result.id} reason=${result.reason}\n`);
      }
    });
    socket.on('error', (err) => {
      log(`control socket client error ${err.message}`);
    });
  });

  controlServer.on('error', (err) => {
    log(`control socket error ${err.message}`);
  });
  controlServer.listen(CONTROL_SOCKET_PATH, () => {
    fs.chmodSync(CONTROL_SOCKET_PATH, 0o660);
    log(`control socket listening path=${CONTROL_SOCKET_PATH}`);
  });
  return controlServer;
}

const controlServer = startControlSocket();

function shutdown(signal) {
  log(`daemon shutdown signal=${signal}`);
  writeDisconnectedStateFiles();
  cleanupCertificate();
  cleanupControlSocket();
  if (backupStore.upload) {
    const upload = backupStore.upload;
    backupStore.upload = null;
    try {
      upload.output.destroy();
    } catch (err) {
      // Ignore shutdown cleanup errors.
    }
    try {
      fs.unlinkSync(upload.tempPath);
    } catch (err) {
      // Ignore a missing or already-cleaned temporary upload.
    }
  }
  controlServer.close();
  for (const client of clients.values()) {
    try {
      client.socket.destroy();
    } catch (err) {
      // Ignore shutdown cleanup errors.
    }
  }
  tcpServer.close(() => {
    if (notificationStore.stream) {
      try {
        notificationStore.stream.end();
      } catch (err) {
        // Ignore shutdown cleanup errors.
      }
    }
    logStream.end(() => process.exit(0));
  });
  setTimeout(() => process.exit(0), 3000).unref();
}

function cleanupCertificate() {
  if (!certDir) {
    return;
  }
  try {
    fs.rmSync(certDir, {recursive: true, force: true});
  } catch (err) {
    log(`certificate cleanup failed ${err.message}`);
  }
  certDir = null;
}

function cleanupControlSocket() {
  try {
    fs.unlinkSync(CONTROL_SOCKET_PATH);
  } catch (err) {
    if (err.code !== 'ENOENT') {
      log(`control socket cleanup failed ${err.message}`);
    }
  }
}

process.on('SIGINT', shutdown);
process.on('SIGTERM', shutdown);
process.on('uncaughtException', (err) => {
  log(`uncaught exception ${err && err.stack ? err.stack : err}`);
  writeDisconnectedStateFiles();
  cleanupCertificate();
  cleanupControlSocket();
  process.exit(1);
});
process.on('unhandledRejection', (err) => {
  log(`unhandled rejection ${err && err.stack ? err.stack : err}`);
  writeDisconnectedStateFiles();
  cleanupCertificate();
  cleanupControlSocket();
  process.exit(1);
});
