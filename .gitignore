# Generated Android build outputs.
# Contains APKs, DEX/classes, generated Java, compiled resources, and local paths.
/build/

# Local debug signing key. Do not commit private keystores.
# (build.sh regenerates one on first run.)
/keystore/debug.keystore

# Native (OpenVPN) build: tarball cache, build trees, install prefix and the
# produced binary. native/build-openvpn.sh is the reproducible producer.
/native/.cache/
/native/build/
/native/prefix/
/app/src/main/jniLibs/

# Live sysmgrd settings contain credentials.
/sysmgrd/sysmgrd.conf

# Local AI-agent instructions.
/AGENTS.md
/CLAUDE.md
